# Dokploy-specific overrides. Loaded on top of prod.env by docker-compose.dokploy.yml.
# Change SITE_URL to match your actual domain before deploying.

# Tell Django to trust the X-Forwarded-Proto header set by Traefik.
# Without this, Django's CSRF protection will reject requests because it
# can't detect that the original connection was HTTPS.
X_FORWARDED_PROTO_HEADER_SET=True
USE_X_FORWARDED_HOST=True

# Must match the domain configured in WGER_DOMAIN.
# Used for links in emails, API cache responses, and the mobile app.
SITE_URL=https://your-domain.com
